// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Enum Types ====================

enum Role {
  PLATFORM // 平台管理员
  MERCHANT // 商家管理员
  MERCHANT_STAFF // 商家员工
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum TaskType {
  NFC_SCAN // NFC碰一碰
  ADD_WECHAT // 添加企业微信
  PHOTO_CHECKIN // 拍照打卡
  DIANPING_REVIEW // 大众点评打卡/评价
  DOUYIN_POST // 抖音发布
  XIAOHONGSHU_POST // 小红书发布
  WECHAT_MOMENTS // 微信朋友圈
  SCREENSHOT_UPLOAD // 截图上传
  AI_COPY // AI文案生成
}

enum TaskStatus {
  LOCKED // 未解锁
  AVAILABLE // 可进行
  SUBMITTED // 已提交待审
  PENDING_REVIEW // 审核中
  APPROVED // 已通过
  REJECTED // 已拒绝
  REWARDED // 已领取奖励
  EXPIRED // 已过期
}

enum VerifyType {
  AUTO // 自动通过
  MANUAL_REVIEW // 人工审核
  SCREENSHOT // 截图校验
  LINK // 链接校验
}

enum RewardType {
  FREE_DRINK // 免费饮品
  FREE_SIDE // 免费小菜
  SIGNATURE_DISH // 招牌荤菜
  DESSERT // 甜品
  LUCKY_DRAW // 抽奖资格
  VOUCHER // 代金券
  ALLIANCE_COUPON // 异业券
  FREE_MEAL // 霸王餐
}

enum ClaimStatus {
  UNCLAIMED // 未领取
  CLAIMED // 已领取
  USED // 已核销
  EXPIRED // 已过期
  CANCELLED // 已取消
}

enum MediaType {
  IMAGE
  VIDEO
}

enum VerificationMethod {
  STAFF_CONFIRM
  LINK
  SCREENSHOT
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LotteryStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum CardStatus {
  ACTIVE // 正常
  USED // 已使用
  LOST // 挂失
}

enum PlatformTarget {
  xiaohongshu
  douyin
  dianping
  weixin_moments
}

enum CopyStyle {
  vibe // 氛围感
  deal_hunter // 性价比
  foodie_review // 探店风
  real_experience // 真实体验
  date_night // 约会聚餐
  friend_gathering // 朋友聚会
}

enum EventType {
  nfc_tap
  page_view
  rule_view
  task_start
  task_submit
  ai_generate
  copy_text
  platform_jump
  proof_upload
  review_approved
  review_rejected
  reward_claimed
  reward_used
  alliance_coupon_clicked
  share_invite
}

// ==================== Core Tables ====================

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  password  String?
  phone     String?  @unique
  wechatId  String?  @unique
  nickname  String?
  role      Role     @default(MERCHANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant      Merchant?
  submissions   TaskSubmission[]
  rewardClaims  RewardClaim[]
  couponClaims  CouponClaim[]
  aiGenerations AIGeneration[]
  events        Event[]
}

model Merchant {
  id              String    @id @default(cuid())
  name            String
  description     String?
  logo            String?
  contact         String?
  phone           String?
  address         String?
  businessLicense String?
  legalPerson     String?
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedBy      String?
  status          Status    @default(PENDING)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stores           Store[]
  alliancePartners AlliancePartner[]
}

model Store {
  id         String   @id @default(cuid())
  name       String
  address    String?
  phone      String?
  status     Status   @default(ACTIVE)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff         Staff[]
  campaigns     Campaign[]
  nfcCards      NfcCard[]
  CampaignStore CampaignStore[]

  @@index([status])
}

model Staff {
  id           String   @id @default(cuid())
  storeId      String
  phone        String   @unique
  name         String?
  role         Role     @default(MERCHANT_STAFF)
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([phone])
}

model Campaign {
  id          String         @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime
  status      CampaignStatus @default(DRAFT)
  merchantId  String
  lotteryDailyQuota Int       @default(3)
  lotteryDrawTime   String?
  lotteryMinScore   Int       @default(60)
  lotteryActive     Boolean   @default(false)
  enforceLbsCheck   Boolean   @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store          Store           @relation(fields: [merchantId], references: [id])
  tasks          CampaignTask[]
  rewards        Reward[]
  stores         CampaignStore[]
  nfcCards       NfcCard[]
  participations Participation[]
  media          CampaignMedia[]
  lotteryEntries LotteryEntry[]
  Event          Event[]

  @@index([status])
  @@index([startDate, endDate])
}

// 活动-门店多对多关系
model CampaignStore {
  campaignId String
  storeId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])

  @@id([campaignId, storeId])
}

model CampaignTask {
  id             String     @id @default(cuid())
  campaignId     String
  taskType       TaskType
  title          String
  description    String?
  completionRule String?
  verifyType     VerifyType @default(MANUAL_REVIEW)
  sortOrder      Int        @default(0)
  rewardId       String?
  status         TaskStatus @default(LOCKED)
  startTime      DateTime?
  endTime        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  campaign    Campaign         @relation(fields: [campaignId], references: [id])
  reward      Reward?          @relation(fields: [rewardId], references: [id])
  submissions TaskSubmission[]
  verifications ParticipationVerification[]

  @@index([campaignId])
  @@index([sortOrder])
}

model TaskSubmission {
  id           String     @id @default(cuid())
  userId       String
  taskId       String
  content      String?
  imageUrls    String[]   @default([])
  platformLink String?
  status       TaskStatus @default(SUBMITTED)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedBy   String?
  submittedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  task            CampaignTask   @relation(fields: [taskId], references: [id])
  Participation   Participation? @relation(fields: [participationId], references: [id])
  participationId String?
  verifications   ParticipationVerification[]

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@index([status])
}

model CampaignMedia {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id])
  url          String
  mediaType    MediaType @default(IMAGE)
  category     String?
  platform     String?
  dishName     String?
  title        String?
  tags         String[]  @default([])
  description  String?
  allowUserUse Boolean   @default(true)
  enabled      Boolean   @default(true)
  sortOrder    Int       @default(0)
  step2Enabled Boolean   @default(false)
  step3Enabled Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([campaignId])
  @@index([mediaType])
  @@index([platform])
  @@index([enabled])
  @@index([step2Enabled])
  @@index([step3Enabled])
}

model Reward {
  id          String     @id @default(cuid())
  campaignId  String
  type        RewardType
  name        String
  description String?
  quantity    Int        @default(0)
  imageUrl    String?
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  campaign      Campaign       @relation(fields: [campaignId], references: [id])
  campaignTasks CampaignTask[]
  claims        RewardClaim[]
  Redemption    Redemption[]

  @@index([campaignId])
}

model RewardClaim {
  id        String      @id @default(cuid())
  userId    String
  rewardId  String
  code      String      @unique
  status    ClaimStatus @default(UNCLAIMED)
  usedAt    DateTime?
  expiredAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([userId])
  @@index([rewardId])
  @@index([code])
  @@index([status])
}

// 用户参与活动记录
model Participation {
  id          String      @id @default(cuid())
  openid      String
  campaignId  String
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  currentTask Int         @default(0)
  status      ClaimStatus @default(UNCLAIMED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  submissions TaskSubmission[]
  redemptions Redemption[]
  verifications ParticipationVerification[]
  lotteryEntries LotteryEntry[]

  @@unique([openid, campaignId])
}

model Redemption {
  id              String        @id @default(cuid())
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id])
  rewardId        String
  reward          Reward        @relation(fields: [rewardId], references: [id])
  code            String        @unique
  status          ClaimStatus   @default(UNCLAIMED)
  redeemedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lotteryEntries LotteryEntry[]
}

model ParticipationVerification {
  id              String             @id @default(cuid())
  participationId String
  participation   Participation      @relation(fields: [participationId], references: [id])
  taskId          String
  task            CampaignTask       @relation(fields: [taskId], references: [id])
  submissionId    String?
  submission      TaskSubmission?    @relation(fields: [submissionId], references: [id])
  method          VerificationMethod
  platform        String?
  link            String?
  screenshotUrl   String?
  status          VerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?
  reviewNote      String?
  qualityScore    Int?
  qualityBreakdown Json?
  lotteryChances  Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([participationId, taskId])
  @@index([taskId])
  @@index([submissionId])
  @@index([status])
  @@index([method])
}

model LotteryEntry {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id])
  participationId String
  participation   Participation @relation(fields: [participationId], references: [id])
  weight          Int           @default(1)
  status          LotteryStatus @default(PENDING)
  drawnAt         DateTime?
  redemptionId    String?
  redemption      Redemption?   @relation(fields: [redemptionId], references: [id])
  qualityScore    Int?
  lat             Float?
  lng             Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([campaignId, participationId])
  @@index([campaignId])
  @@index([participationId])
  @@index([status])
}

model NfcCard {
  id          String     @id @default(cuid())
  code        String     @unique
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  campaignId  String?
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])
  tableNumber String?
  status      CardStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events Event[]

  @@index([code])
  @@index([storeId])
  @@index([campaignId])
}

model Review {
  id         String   @id @default(cuid())
  content    String
  rating     Int
  userId     String
  merchantId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==================== Alliance ====================

model AlliancePartner {
  id           String   @id @default(cuid())
  name         String
  type         String?
  contactName  String?
  contactPhone String?
  status       Status   @default(ACTIVE)
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coupons        CouponClaim[]
  AllianceCoupon AllianceCoupon[]

  @@index([status])
}

model AllianceCoupon {
  id          String          @id @default(cuid())
  name        String
  description String?
  discount    Float
  validFrom   DateTime
  validUntil  DateTime
  partnerId   String
  partner     AlliancePartner @relation(fields: [partnerId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  claims CouponClaim[]

  @@index([partnerId])
}

model CouponClaim {
  id        String      @id @default(cuid())
  userId    String
  couponId  String
  code      String      @unique
  status    ClaimStatus @default(UNCLAIMED)
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user              User             @relation(fields: [userId], references: [id])
  coupon            AllianceCoupon   @relation(fields: [couponId], references: [id])
  AlliancePartner   AlliancePartner? @relation(fields: [alliancePartnerId], references: [id])
  alliancePartnerId String?

  @@index([userId])
  @@index([couponId])
}

// ==================== Event & Analytics ====================

model Event {
  id         String    @id @default(cuid())
  eventType  EventType
  userId     String?
  campaignId String?
  nfcCardId  String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  nfcCard  NfcCard?  @relation(fields: [nfcCardId], references: [id])

  @@index([eventType])
  @@index([userId])
  @@index([campaignId])
  @@index([nfcCardId])
  @@index([createdAt])
}

model AIGeneration {
  id               String         @id @default(cuid())
  userId           String
  storeName        String
  storeDescription String?
  dishName         String?
  campaignTheme    String
  platform         PlatformTarget
  style            CopyStyle
  inputPrompt      String
  outputText       String
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ==================== Audit ====================

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorRole  Role?
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
